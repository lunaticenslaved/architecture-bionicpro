# Реквизиты приложения Яндекс ID (Identity Brokering).
# Скопируйте этот файл в .env и подставьте реальные значения из
# https://oauth.yandex.ru (страница вашего приложения).
#
# Redirect URI приложения Яндекса должен быть:
#   http://localhost:8080/realms/reports-realm/broker/yandex/endpoint
#
# Значения подхватываются docker compose и передаются в контейнер keycloak,
# который подставляет их в realm-export.json (${env.YANDEX_CLIENT_ID}) при импорте.

YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
